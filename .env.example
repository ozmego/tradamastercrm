# Veritabani (docker compose up -d ile ayaga kalkan Postgres)
DATABASE_URL=postgresql+psycopg://tradecrm:tradecrm@localhost:5434/tradecrm

# Binance (yalnizca trading yetkisi verin, withdrawal KAPALI birakin)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Once testnet ile deneyin (https://testnet.binance.vision, ayri anahtar): true
BINANCE_TESTNET=false

# KuCoin (canli islem): yalnizca Spot/Trade izni, Withdrawal KAPALI, IP kisitli
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Telegram bildirimleri
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CryptoPanic haber API
CRYPTOPANIC_API_KEY=

# Islem ayarlari
SYMBOL=BTC/USDT
TIMEFRAME=1h
# Profil: baseline | exits | exits_risk | guarded | trend | trend_mtf | donchian | donchian_mtf (bkz. src/tradecrm/strategy/profiles.py)
PROFILE=donchian

# Guvenlik / risk
# CANLI emir ana salteri: ikisi birden (TRADING_ENABLED=true, DRY_RUN=false) olmadan canli hesapta
# hicbir emir verilmez; DB bayragi (tradecrm risk enable-trading) da ayrica acik olmali. Paper'i etkilemez.
TRADING_ENABLED=false
DRY_RUN=true
TOTAL_CAPITAL_ALLOCATION_PCT=0.35
DAILY_GROWTH_TARGET_PCT=0.0075
MIN_POSITION_FRACTION=0.2
MAX_POSITION_FRACTION=1.0
MAX_DAILY_LOSS_PCT=0.05
DAILY_TARGET_STOP_ON_HIT=false

# Haber-duyarli strateji (varsayilan kapali)
NEWS_SENTIMENT_ENABLED=false
NEWS_WINDOW_HOURS=6
NEWS_BLOCK_BUY_THRESHOLD=-0.3
NEWS_MIN_VOTES_THRESHOLD=5
NEWS_MIN_ITEMS_THRESHOLD=3
NEWS_CACHE_TTL_SECONDS=300

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Panel oturum suresi (saat) ve HTTPS reverse proxy arkasinda Secure cerez
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false

# Veri toplayici
COLLECT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,LINK/USDT,AVAX/USDT,LTC/USDT
COLLECT_RETENTION_DAYS=45
